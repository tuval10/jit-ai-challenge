# ================================
# Script Dockerizer Configuration
# ================================

# LLM Provider API Keys (choose one or more)
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# Default LLM Provider (openai|anthropic|google)
DEFAULT_LLM_PROVIDER=openai

# LLM Configuration
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500

# Model Selection (optional - uses optimized defaults if not set)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-haiku-20240307
# GOOGLE_MODEL=gemini-1.5-flash

# Docker Configuration
DOCKER_TEMP_DIR=/tmp/claude
DOCKER_TIMEOUT=60000

# Development Settings
NODE_ENV=development
LOG_LEVEL=info

# Testing (set to 'true' to enable by default)
# DEFAULT_TEST_MODE=false
# DEFAULT_STREAM_MODE=false
# DEFAULT_CLEANUP_MODE=false